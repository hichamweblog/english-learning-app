    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "fuse.js": "^7.0.0",
    "zod": "^3.23.0",
    "react-virtuoso": "^4.10.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.0",
