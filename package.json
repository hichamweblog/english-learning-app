    "content:extract:all": "node scripts/extract/extract-daily-english.mjs --all && node scripts/extract/extract-cultural-english.mjs --all && node scripts/extract/extract-fluent-vip.mjs --all"
  },
  "dependencies": {
    "next": "^16.0.0",
